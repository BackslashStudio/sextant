@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenGL REQUIRED)

# sextant_static links these PUBLIC — a static library can't embed its
# dependencies' object code the way sextant.dll does, so a consumer linking
# sextant::sextant_static needs these same imported targets resolvable.
#
# They are looked up QUIET and non-REQUIRED on purpose. This file is also read
# by consumers who only want sextant::sextant, which has FreeType, libpng, zlib
# and GLFW linked into it and needs none of them present at build time; making
# these hard requirements meant `find_package(sextant)` failed for everyone
# unless FreeType and libpng development files happened to be findable, which
# contradicts the whole point of the shared library. A consumer who does link
# the static target without them gets a clear "target not found" error at
# generate time instead.
if(@SEXTANT_BUILD_STATIC@)
    find_package(Threads QUIET)   # transitively required by glfw
    if(@SEXTANT_USE_FREETYPE@)
        find_package(Freetype QUIET)
    endif()
    if(@SEXTANT_USE_LIBPNG@)
        find_package(PNG QUIET)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sextantTargets.cmake")

check_required_components(sextant)
